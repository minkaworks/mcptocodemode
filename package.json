{
  "name": "mcptocodemode",
  "version": "0.2.1",
  "description": "Turn any set of MCP servers into one Code Mode server: search, describe, execute.",
  "author": "dqniel",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-mode",
    "mcp-server",
    "mcp-gateway",
    "mcp-proxy",
    "quickjs",
    "sandbox"
  ],
  "homepage": "https://github.com/minkaworks/mcptocodemode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minkaworks/mcptocodemode.git"
  },
  "bugs": {
    "url": "https://github.com/minkaworks/mcptocodemode/issues"
  },
  "type": "module",
  "bin": {
    "mcptocodemode": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "SPEC.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "measure": "node scripts/measure.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "quickjs-emscripten": "^0.31.0",
    "smol-toml": "^1.9.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
