{
  "name": "mcptocodemode",
  "version": "0.3.0",
  "description": "Stop flooding your agent's prompt with MCP tools: MCPtoCodeMode puts every MCP server behind 3 tools and a sandbox, for Codex, Claude Code, Cursor, Grok, OpenCode, Pi, or any MCP client.",
  "author": "dqniel",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-mode",
    "mcp-server",
    "mcp-gateway",
    "mcp-proxy",
    "quickjs",
    "sandbox"
  ],
  "homepage": "https://github.com/minkaworks/mcptocodemode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minkaworks/mcptocodemode.git"
  },
  "bugs": {
    "url": "https://github.com/minkaworks/mcptocodemode/issues"
  },
  "type": "module",
  "bin": {
    "mcptocodemode": "dist/cli.js",
    "cm": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "SPEC.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "measure": "node scripts/measure.mjs",
    "bench:model": "node scripts/bench-model.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "quickjs-emscripten": "^0.31.0",
    "smol-toml": "^1.9.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "express": "^5.3.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
